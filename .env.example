# Gemini API Key for server-side document parsing and CV generation
GEMINI_API_KEY=

# Reverse proxy hop count (default: 1; set 0 to disable).
# Pakai 1 hanya jika tepat satu proxy berada di depan aplikasi (misalnya Cloud Run); pakai 0 jika dijalankan tanpa proxy.
# TRUST_PROXY_HOPS=1

# Optional Rate Limit overrides for POST /api/parse-cv
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=30
# RATE_LIMIT_GLOBAL_PER_DAY=300
